{
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/beacon-notebook.webp", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/beacon-social.jpg", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/latest.json", "headers": { "Cache-Control": "no-store" } },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" }
  ],
  "responseOverrides": { "404": { "rewrite": "/404.html", "statusCode": 404 } },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
  }
}
