{
  "name": "game-text-beacon",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "build:site": "vite build --outDir dist/site",
    "preview": "vite preview --outDir dist/site",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop-local-ocr": "./scripts/install-linux-prereqs.sh && cargo test --manifest-path src-tauri/Cargo.toml claim_desktop_local_ocr",
    "test:linux-package": "./scripts/install-linux-prereqs.sh && npm run tauri build -- --bundles deb && node scripts/test-bundled-ocr-runtime.mjs --kind deb && node scripts/test-linux-package.mjs",
    "test:linux-hotkey-package": "./scripts/install-linux-prereqs.sh && npm run tauri build -- --bundles deb && node scripts/test-linux-hotkey-package.mjs",
    "test:bundled-ocr-runtime": "node scripts/test-bundled-ocr-runtime.mjs",
    "test:compatibility": "npm run test:linux-hotkey-package && ./scripts/install-compatibility-fixtures.sh && node scripts/test-five-title-compatibility.mjs",
    "test:watch": "vitest",
    "tauri": "node scripts/tauri.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test:claims": "node scripts/test-claims.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
